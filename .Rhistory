# Graphique
ggplot(comparaison_cpue3,
aes(x = saison, y = cpue,
group = type,
linetype = type,
shape = type,
color = type)) +
geom_errorbar(
aes(ymin = ic_inf, ymax = ic_sup),
width = 0.15,
na.rm = TRUE
) +
geom_line(linewidth = 0.8) +
# Points des CPUE
geom_point(
data = subset(comparaison_cpue3, type != "French quota"),
size = 3,
fill = "white",
stroke = 1
) +
# Points du quota français
geom_point(
data = subset(comparaison_cpue3, type == "French quota"),
aes(fill = quota_recent),
shape = 21,
size = 3,
stroke = 1,
color = "steelblue"
) +
scale_fill_manual(
values = c("FALSE" = "white", "TRUE" = "red"),
guide = "none"
) +
scale_color_manual(
values = c(
"raw CPUE" = "darkorange2",
"standardized CPUE" = "darkorange2",
"French quota" = "steelblue"
),
breaks = c("raw CPUE", "standardized CPUE", "French quota")
) +
scale_shape_manual(
values = c(
"raw CPUE" = 21,
"standardized CPUE" = 21,
"French quota" = 21
)
) +
scale_linetype_manual(
values = c(
"raw CPUE" = "solid",
"standardized CPUE" = "dashed",
"French quota" = "solid"
)
) +
scale_y_continuous(
name = "Standardized values (z-score)",
breaks = scales::pretty_breaks()
) +
scale_x_discrete(drop = FALSE) +
labs(
title = "Comparison of standardized CPUE and French quota",
x = "Fishing season",
color = NULL,
shape = NULL,
linetype = NULL
) +
theme_minimal() +
theme(
legend.position = c(0.78, 0.92),
legend.background = element_rect(
fill = scales::alpha("white", 0.7),
colour = NA
),
axis.text = element_text(size = 14),
axis.text.x = element_text(angle = 45, hjust = 1),
axis.title = element_text(size = 16),
plot.title = element_text(size = 15),
legend.text = element_text(size = 12),
axis.title.y.left = element_text(color = "black"),
axis.text.y.left = element_text(color = "black")
) +
guides(
color = guide_legend(
override.aes = list(
linewidth = 1,
shape = c(21, 21, 21),
linetype = c("solid", "dashed", "solid")
)
),
shape = "none",
linetype = "none"
)
# Préparer les CPUE
cpue_plot <- comparaison_cpue2 %>%
mutate(
saison = as.character(saison)
) %>%
group_by(type) %>%
mutate(
moyenne = mean(cpue, na.rm = TRUE),
ecart_type = sd(cpue, na.rm = TRUE),
cpue = (cpue - moyenne) / ecart_type,
ic_inf = (ic_inf - moyenne) / ecart_type,
ic_sup = (ic_sup - moyenne) / ecart_type
) %>%
ungroup() %>%
select(-moyenne, -ecart_type)
# Préparer et centrer-réduire les quotas français
quota_plot <- quota %>%
mutate(saison = as.character(Saison)) %>%
filter(saison %in% c(
as.character(unique(comparaison_cpue2$saison)),
"2025-2026",
"2026-2027"
)) %>%
mutate(
moyenne_quota = mean(Quota, na.rm = TRUE),
ecart_type_quota = sd(Quota, na.rm = TRUE)
) %>%
transmute(
saison = saison,
cpue = (Quota - moyenne_quota) / ecart_type_quota,
ic_inf = NA_real_,
ic_sup = NA_real_,
type = "French quota",
quota_recent = saison %in% c("2025-2026", "2026-2027")
)
# Combiner les données
comparaison_cpue3 <- bind_rows(
cpue_plot %>%
mutate(quota_recent = NA) %>%
select(saison, cpue, ic_inf, ic_sup, type, quota_recent),
quota_plot
) %>%
mutate(
saison = factor(
saison,
levels = sort(unique(saison))
)
)
# Graphique
ggplot(comparaison_cpue3,
aes(x = saison, y = cpue,
group = type,
linetype = type,
shape = type,
color = type)) +
geom_errorbar(
