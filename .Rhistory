ggplot(comparaison_cpue3,
aes(x = saison, y = cpue,
group = type,
linetype = type,
shape = type,
color = type)) +
geom_errorbar(
aes(ymin = ic_inf, ymax = ic_sup),
width = 0.15,
na.rm = TRUE
) +
geom_line(linewidth = 0.8) +
geom_point(size = 3, fill = "white", stroke = 1) +
scale_color_manual(values = c(
"raw CPUE" = "darkorange2",
"standardized CPUE" = "darkorange2",
"French quota" = "steelblue"
)) +
scale_shape_manual(values = c(
"raw CPUE" = 21,
"standardized CPUE" = 21,
"French quota" = 21
)) +
scale_linetype_manual(values = c(
"raw CPUE" = "solid",
"standardized CPUE" = "dashed",
"French quota" = "solid"
)) +
scale_y_continuous(
name = "CPUE (kg per fishing operation)",
sec.axis = sec_axis(
~ . / facteur,
name = "French quota (tonnes)"
)
) +
labs(
title = "Comparison of raw and standardized CPUE with the French quota",
x = "Fishing season",
color = NULL,
shape = NULL,
linetype = NULL
) +
theme_minimal() +
theme(
legend.position = c(0.78, 0.92),
legend.background = element_rect(
fill = alpha("white", 0.7),
colour = NA
),
axis.text = element_text(size = 14),
axis.text.x = element_text(angle = 45, hjust = 1),
axis.title = element_text(size = 16),
plot.title = element_text(size = 15),
legend.text = element_text(size = 12),
axis.title.y.right = element_text(color = "steelblue"),
axis.text.y.right = element_text(color = "steelblue")
) +
guides(
color = guide_legend(
override.aes = list(
linewidth = 1,
shape = c(21, 21, 21),
linetype = c("solid", "dashed", "solid")
)
),
shape = "none",
linetype = "none"
)
# Préparer les quotas français
quota_plot <- quota %>%
filter(Saison %in% as.character(unique(comparaison_cpue2$saison))) %>%
transmute(
saison = as.character(Saison),
quota = Quota
)
# Préparer les CPUE
cpue_plot <- comparaison_cpue2 %>%
mutate(saison = as.character(saison))
# Centrer-réduire les CPUE
cpue_plot <- cpue_plot %>%
group_by(type) %>%
mutate(
cpue_cr = as.numeric(scale(cpue))
) %>%
ungroup()
# Centrer-réduire les quotas
quota_plot <- quota_plot %>%
mutate(
cpue_cr = as.numeric(scale(quota)),
ic_inf = NA_real_,
ic_sup = NA_real_,
type = "French quota"
) %>%
select(saison, cpue = cpue_cr, ic_inf, ic_sup, type)
# Combiner les données
comparaison_cpue3 <- bind_rows(
cpue_plot %>%
mutate(cpue = cpue_cr) %>%
select(saison, cpue, ic_inf, ic_sup, type),
quota_plot
)
# Graphique
ggplot(comparaison_cpue3,
aes(x = saison, y = cpue,
group = type,
linetype = type,
shape = type,
color = type)) +
geom_errorbar(
aes(ymin = ic_inf, ymax = ic_sup),
width = 0.15,
na.rm = TRUE
) +
geom_line(linewidth = 0.8) +
geom_point(
size = 3,
fill = "white",
stroke = 1
) +
scale_color_manual(values = c(
"raw CPUE" = "darkorange2",
"standardized CPUE" = "darkorange2",
"French quota" = "steelblue"
)) +
scale_shape_manual(values = c(
"raw CPUE" = 21,
"standardized CPUE" = 21,
"French quota" = 21
)) +
scale_linetype_manual(values = c(
"raw CPUE" = "solid",
"standardized CPUE" = "dashed",
"French quota" = "solid"
)) +
scale_y_continuous(
name = "Standardized values (z-score)"
) +
labs(
title = "Comparison of standardized CPUE and French quota",
x = "Fishing season",
color = NULL,
shape = NULL,
linetype = NULL
) +
theme_minimal() +
theme(
legend.position = c(0.78, 0.92),
legend.background = element_rect(
fill = scales::alpha("white", 0.7),
colour = NA
),
axis.text = element_text(size = 14),
axis.text.x = element_text(
angle = 45,
hjust = 1
),
axis.title = element_text(size = 16),
plot.title = element_text(size = 15),
legend.text = element_text(size = 12),
axis.title.y = element_text(color = "black")
) +
guides(
color = guide_legend(
override.aes = list(
linewidth = 1,
