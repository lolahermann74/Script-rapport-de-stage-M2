# Préparer les CPUE et les centrer-réduire
cpue_plot <- comparaison_cpue2 %>%
mutate(saison = as.character(saison)) %>%
group_by(type) %>%
mutate(
moyenne = mean(cpue, na.rm = TRUE),
ecart_type = sd(cpue, na.rm = TRUE),
cpue = (cpue - moyenne) / ecart_type,
ic_inf = (ic_inf - moyenne) / ecart_type,
ic_sup = (ic_sup - moyenne) / ecart_type
) %>%
ungroup() %>%
select(-moyenne, -ecart_type)
# Préparer l'indice WGEEL 2025
indice_WGEEL25_plot <- indice_WGEEL25 %>%
mutate(saison = as.character(saison)) %>%
mutate(
moyenne = mean(indice, na.rm = TRUE),
ecart_type = sd(indice, na.rm = TRUE),
cpue = (indice - moyenne) / ecart_type,
ic_inf = NA_real_,
ic_sup = NA_real_,
type = "WGEEL 2025 index"
) %>%
select(saison, cpue, ic_inf, ic_sup, type)
# Combiner les données
comparaison_cpue3 <- bind_rows(
cpue_plot,
indice_WGEEL25_plot
) %>%
mutate(
saison = factor(
saison,
levels = sort(unique(as.character(saison)))
)
)
